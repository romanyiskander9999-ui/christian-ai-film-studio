OPENAI_API_KEY=ضع_مفتاحك_هنا
OPENAI_MODEL=gpt-4.1-mini

# Optional self-hosted open-source video generation (ComfyUI + Wan 2.2)
# Use a reachable ComfyUI server URL, e.g. http://127.0.0.1:8188
COMFYUI_API_URL=
# Full ComfyUI API-format workflow JSON (not the visual workflow export)
COMFYUI_WORKFLOW_JSON=
# Node ID in that workflow whose input receives the positive prompt
COMFYUI_PROMPT_NODE_ID=
# Input key in the node, commonly "text"
COMFYUI_PROMPT_INPUT=text

# Runway is intentionally disabled by the application. No Runway key is required.
